{
  "name": "pi-cli-subagents",
  "version": "0.4.0",
  "description": "Delegate work from a Pi session to persistent Pi, Codex CLI and Claude Code subagents",
  "license": "MIT",
  "author": "joshua-zyy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshua-zyy/pi-cli-subagents.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents",
    "codex",
    "claude-code"
  ],
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/test.mjs all",
    "test:fast": "npm run build && node scripts/test.mjs fast",
    "test:domain": "npm run build && node scripts/test.mjs domain",
    "test:acceptance:local": "npm run build && node scripts/test.mjs acceptance-local",
    "test:list": "node scripts/test.mjs all --list",
    "prepack": "npm run build",
    "test:acceptance:slow": "npm run build && node scripts/test.mjs acceptance-slow",
    "gates": "node scripts/gates.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent@1.0.1": {
      "@earendil-works/pi-codemode": "1.0.1"
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@earendil-works/pi-tui": "1.0.1",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
